| Function              | Purpose                     |
| --------------------- | --------------------------- |
| `CONCAT()`            | Join strings                |
| `CONCAT_WS()`         | Join strings with separator |
| `LENGTH()`            | Find byte length            |
| `CHAR_LENGTH()`       | Find character length       |
| `UPPER()` / `UCASE()` | Convert to uppercase        |
| `LOWER()` / `LCASE()` | Convert to lowercase        |
| `TRIM()`              | Remove spaces               |
| `LTRIM()`             | Remove left spaces          |
| `RTRIM()`             | Remove right spaces         |
| `SUBSTRING()`         | Extract part of string      |
| `LEFT()`              | Get characters from left    |
| `RIGHT()`             | Get characters from right   |
| `INSTR()`             | Find substring position     |
| `LOCATE()`            | Find substring position     |
| `REPLACE()`           | Replace text                |
| `REVERSE()`           | Reverse string              |
| `REPEAT()`            | Repeat string               |
| `LPAD()`              | Pad from left               |
| `RPAD()`              | Pad from right              |
| `SUBSTRING_INDEX()`   | Extract based on delimiter  |
| `ASCII()`             | Get ASCII value             |
| `STRCMP()`            | Compare strings             |
| `LIKE`                | Pattern matching            |


SELECT concat(name," ",dept)FROM EMPLOYEE ;

+-------------------+
| concat(name,dept) |
+-------------------+
| ClarkSales        |
| DaveAccounting    |
| AvaSales          |
+-------------------+

SELECT concat_ws("-",name,dept,empid)FROM EMPLOYEE ;

+--------------------------------+
| concat_ws("-",name,dept,empid) |
+--------------------------------+
| Clark-Sales-1                  |
| Dave-Accounting-2              |
| Ava-Sales-3                    |
+--------------------------------+

SELECT name,length(name) as length FROM EMPLOYEE ;

+-------+--------+
| name  | length |
+-------+--------+
| Clark |      5 |
| Dave  |      4 |
| Ava   |      3 |
+-------+--------+

SELECT name,char_length(name) as length FROM EMPLOYEE ;

+----------+--------+
| name     | length |
+----------+--------+
| Clark jo |      8 |
| Dave     |      4 |
| Ava      |      3 |
+----------+--------+

SELECT name,lower(name),upper(name)  FROM EMPLOYEE ;

