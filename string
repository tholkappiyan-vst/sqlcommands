SELECT name,trim(name), Ltrim(name) ,Rtrim(name) FROM EMPLOYEE ;

+--------------+------------+-------------+-------------+
| name         | trim(name) | Ltrim(name) | Rtrim(name) |
+--------------+------------+-------------+-------------+
|   Clark jo   | Clark jo   | Clark jo    |   Clark jo  |
|   Dave       | Dave       | Dave        |   Dave      |
